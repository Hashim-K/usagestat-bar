FROM registry.fedoraproject.org/fedora:44 AS desktop
RUN dnf install -y --setopt=install_weak_deps=False \
    gjs libadwaita gtk4 glib2 dconf dbus-daemon python3 python3-gobject \
    xorg-x11-server-Xvfb xorg-x11-xauth openbox xdotool ImageMagick \
    plasma-workspace plasma-desktop kwin kwin-x11 cinnamon cinnamon-settings-daemon \
    xfce4-panel xfce4-session xfce4-genmon-plugin lxqt-panel mate-panel \
    budgie-desktop cosmic-panel cosmic-comp cosmic-applets sway waybar polybar i3 bspwm \
    labwc grim wlrctl dunst procps-ng which zip unzip rsync findutils diffutils \
    && dnf clean all
RUN dnf install -y --setopt=install_weak_deps=False gcc pkgconf-pkg-config gtk3-devel json-glib-devel xfce4-panel-devel && dnf clean all
RUN dnf install -y --setopt=install_weak_deps=False mate-control-center xfce4-settings lxqt-config cosmic-settings && dnf clean all
RUN dnf install -y --setopt=install_weak_deps=False cinnamon-control-center gnome-terminal && dnf clean all
RUN useradd --uid 1000 --create-home reviewer
RUN dnf install -y --setopt=install_weak_deps=False gtk4-layer-shell && dnf clean all
RUN dnf install -y --setopt=install_weak_deps=False wayvnc dejavu-sans-fonts && dnf clean all
RUN dnf install -y --setopt=install_weak_deps=False \
    cosmic-bg cosmic-wallpapers cosmic-session mate-backgrounds xfdesktop \
    lxqt-themes pcmanfm-qt feh glibc-langpack-en && dnf clean all

FROM desktop AS cosmic-build
RUN dnf install -y --setopt=install_weak_deps=False \
    cargo rust gcc-c++ git make patch pkgconf-pkg-config clang-devel \
    libinput-devel libseat-devel libudev-devel libxkbcommon-devel \
    libdisplay-info-devel mesa-libEGL-devel mesa-libgbm-devel pixman-devel \
    wayland-devel libX11-devel libXcursor-devel libXi-devel libXrandr-devel \
    libxcb-devel libei-devel systemd-devel vulkan-loader-devel && dnf clean all
COPY build-cosmic.sh /tmp/build-cosmic.sh
COPY patches/smithay-destroyed-layer.patch /tmp/smithay-destroyed-layer.patch
RUN bash /tmp/build-cosmic.sh

FROM desktop
COPY --from=cosmic-build /usr/local/bin/cosmic-comp /usr/bin/cosmic-comp
COPY --from=cosmic-build /usr/share/usagestat-lab/cosmic-build.txt /usr/share/usagestat-lab/cosmic-build.txt
COPY backgrounds.json fetch-backgrounds.py /usr/share/usagestat-lab/
RUN python3 /usr/share/usagestat-lab/fetch-backgrounds.py
