{
  "custom/usagestat": {
    "exec": "usagestat-bar waybar --watch",
    "return-type": "json",
    "restart-interval": 1,
    "exec-on-event": false,
    "smooth-scrolling-threshold": 1,
    "format": "{text}",
    "on-click": "usagestat-bar toggle",
    "on-click-right": "usagestat-bar preferences",
    "on-click-middle": "usagestat-bar refresh",
    "on-scroll-up": "usagestat-bar scroll-previous",
    "on-scroll-down": "usagestat-bar scroll-next",
    "escape": false
  }
}
